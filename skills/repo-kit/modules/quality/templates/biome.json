{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "{%defaultBranch%}" },
  "files": { "includes": ["**", "!tools/biome/fixtures", "!.repo-kit.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "markdown": { "formatter": { "enabled": false } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": { "noUnusedImports": "error", "noUnusedVariables": "error" },
      "suspicious": { "noExplicitAny": "error", "noFocusedTests": "error" },
      "nursery": { "noFloatingPromises": "error", "noMisusedPromises": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "plugins": [
        "./tools/biome/rules/no-snapshot-assertions.grit",
        "./tools/biome/rules/no-test-id-queries.grit",
        "./tools/biome/rules/no-sleep-in-tests.grit",
        "./tools/biome/rules/no-module-mocking.grit",
        "./tools/biome/rules/no-class-style-assertions.grit"
      ]
    }
  ]
}
